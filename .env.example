# ── Nombre de la app ─────────────────────────────────────────────────────────
APP_NAME=Sistema de Gestión de Atenciones Remotas

# ── Base de datos ─────────────────────────────────────────────────────────────
# LOCAL (SQLite — desarrollo)
DB_URL=sqlite:///data/soporte.db

# PRODUCCIÓN (Supabase / PostgreSQL)
# Obtener en: Supabase → Settings → Database → Connection string → URI
# Formato: postgresql+psycopg2://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# DB_URL=postgresql+psycopg2://postgres:TU_PASSWORD@db.yfvyskjoybuukbqhwpqf.supabase.co:5432/postgres

# ── Admin inicial (se crea automáticamente si no existe) ──────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=Cambiar_Esta_Clave_2026
